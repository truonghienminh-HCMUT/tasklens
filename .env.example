# Sao chép file này thành ".env" rồi điền key của bạn. File .env đã bị .gitignore chặn, không lên GitHub.
# Model Swap Test cần ít nhất 2 nhà cung cấp. Cấu hình mặc định: Gemini + Groq (cả hai miễn phí).

# Google Gemini (miễn phí): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Groq, model mã nguồn mở (miễn phí): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# (Tùy chọn, trả phí) OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# (Tùy chọn, trả phí) Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
